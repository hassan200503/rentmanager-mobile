# Copy to .env for local development. Every EXPO_PUBLIC_* value is compiled
# into the app and is PUBLIC. Never put a secret key here.

# Build identity: development | staging | production (read by app.config.ts)
APP_ENV=development

# Backend origin including /api/v1. Android emulator reaches the host as 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Clerk *publishable* key (pk_test_… / pk_live_…) — same Clerk instance as the web app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# JWT template the backend verifies. Must match the web app ("backend").
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=backend

# Web app origin, for workflows left to a large screen.
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000

# Optional: Sentry DSN (public ingest key). Leave empty to disable monitoring.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (not EXPO_PUBLIC): Expo project for push tokens and EAS.
EAS_PROJECT_ID=
EXPO_OWNER=
SENTRY_ORG=
SENTRY_PROJECT=
